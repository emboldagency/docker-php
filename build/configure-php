# Copy php.ini to all conf.d folders under /etc/php
for dir in /etc/php/*/*/; do
  echo "$dir"
  if [ -d "$dir/conf.d" ]; then
    sudo cp -f /coder/90-embold-php.ini "$dir/conf.d"
  fi
done

# Initialize mysql
if [ ! -f "/home/embold/.mysql-initialized" ] 
then
  sudo sleep 10

  sudo mysql -e "GRANT ALL PRIVILEGES ON * . * TO 'embold'@'%';" && \
  sudo mysql -e "FLUSH PRIVILEGES;" && \
  touch /home/embold/.mysql-initialized
fi
